#!/bin/sh
set -eu
APP=/opt/asterisk-ha
CONF=/config/asterisk
IVR_AUDIO=/share/asterisk-ivr
F2B_SOCKET=/run/fail2ban/fail2ban.sock
F2B_PIDFILE=/run/fail2ban/fail2ban.pid
WAKEUP_PROMPT=/var/lib/asterisk/sounds/ha/wakeup-pt.wav
mkdir -p "$CONF" /config/state /share/asterisk-recordings "$IVR_AUDIO" /var/log/asterisk /var/spool/asterisk /var/run/asterisk /run/fail2ban /data/fail2ban

# The wake-up prompt is built into the image, but verify it on every startup.
# If the file is missing or has the wrong telephony format, recreate it locally.
# This makes Serviço Despertar independent from external sound downloads.
repair_wakeup_prompt() {
  regenerate=0
  [ -s "$WAKEUP_PROMPT" ] || regenerate=1
  if [ "$regenerate" = "0" ]; then
    rate="$(soxi -r "$WAKEUP_PROMPT" 2>/dev/null || true)"
    channels="$(soxi -c "$WAKEUP_PROMPT" 2>/dev/null || true)"
    bits="$(soxi -b "$WAKEUP_PROMPT" 2>/dev/null || true)"
    [ "$rate" = "8000" ] || regenerate=1
    [ "$channels" = "1" ] || regenerate=1
    [ "$bits" = "16" ] || regenerate=1
  fi
  if [ "$regenerate" = "1" ]; then
    echo "[Wakeup] repairing bundled PT-PT prompt"
    mkdir -p "$(dirname "$WAKEUP_PROMPT")"
    espeak-ng -v pt-pt -s 145 -w /tmp/wakeup-ha-src.wav \
      "Bom dia. Esta e a sua chamada de despertar. Por favor, acorde."
    sox /tmp/wakeup-ha-src.wav -r 8000 -c 1 -b 16 "$WAKEUP_PROMPT"
    rm -f /tmp/wakeup-ha-src.wav
  fi
  test -s "$WAKEUP_PROMPT"
  echo "[Wakeup] prompt ready: $(soxi -r "$WAKEUP_PROMPT") Hz, $(soxi -c "$WAKEUP_PROMPT") channel(s), $(soxi -b "$WAKEUP_PROMPT") bit"
}
repair_wakeup_prompt

# Make custom Asterisk sounds persistent. Preserve any image-provided custom
# sounds before replacing the custom directory with a symlink to /share.
link_custom_dir() {
  base="$1"
  target="$base/custom"
  mkdir -p "$base"
  if [ -d "$target" ] && [ ! -L "$target" ]; then
    cp -an "$target"/. "$IVR_AUDIO"/ 2>/dev/null || true
    rm -rf "$target"
  fi
  ln -sfn "$IVR_AUDIO" "$target"
}

link_custom_dir /var/lib/asterisk/sounds
for langdir in /var/lib/asterisk/sounds/*; do
  [ -d "$langdir" ] || continue
  [ "$(basename "$langdir")" = "custom" ] && continue
  link_custom_dir "$langdir"
done

# Seed editable Asterisk configuration exactly once.
for f in /etc/asterisk-template/*; do
  name="$(basename "$f")"
  [ -e "$CONF/$name" ] || cp "$f" "$CONF/$name"
done

python3 "$APP/bootstrap.py"
# extensions.conf is persistent across add-on upgrades. Always inject/update the
# dedicated wake-up playback context before Asterisk starts so old installs get
# the same media fix as fresh installs.
python3 "$APP/wakeup_dialplan.py"

# Fail2ban is deliberately non-fatal for PBX availability. Use fail2ban-client
# to start BOTH server and jails, but request foreground mode so the process is
# stable inside this container without systemd. One explicit socket path is
# shared by startup, status API and shutdown.
# Legacy mode `fail2ban-client -x start` is intentionally replaced by the
# foreground/supervised invocation below.
F2B_STARTED=0
F2B_PID=""
F2B_WATCH_PID=""
F2B_ENABLED="$(python3 - <<'PY'
import json
try:
    print('1' if json.load(open('/data/options.json')).get('fail2ban_enabled', True) else '0')
except Exception:
    print('1')
PY
)"
if [ "$F2B_ENABLED" = "1" ]; then
  rm -f "$F2B_SOCKET" "$F2B_PIDFILE"
  : > /data/fail2ban/server.log
  if python3 "$APP/fail2ban_setup.py" >/data/fail2ban/generated.json 2>/data/fail2ban/setup-error.log \
     && fail2ban-client -s "$F2B_SOCKET" -p "$F2B_PIDFILE" -t >/data/fail2ban/config-test.log 2>&1; then
    fail2ban-client -f -x -s "$F2B_SOCKET" -p "$F2B_PIDFILE" start >>/data/fail2ban/server.log 2>&1 &
    F2B_PID=$!
    i=0
    while [ "$i" -lt 40 ]; do
      if fail2ban-client -s "$F2B_SOCKET" ping >/data/fail2ban/ping.log 2>&1; then
        F2B_STARTED=1
        break
      fi
      if ! kill -0 "$F2B_PID" 2>/dev/null; then
        break
      fi
      i=$((i+1))
      sleep 0.25
    done
  fi

  if [ "$F2B_STARTED" = "1" ]; then
    echo "[SECURITY] Fail2ban ativo: asterisk-pjsip + asterisk-web"

    # One-time recovery for 0.2.36. During the previous PBX registration outage,
    # legitimate remote SIP clients could accumulate persistent bans in the
    # asterisk-pjsip jail. Clear only that jail once, keep asterisk-web bans and
    # leave Fail2ban enabled normally afterwards.
    F2B_RECOVERY_MARKER=/data/fail2ban/recovery-0.2.36-pjsip-unban.done
    if [ ! -e "$F2B_RECOVERY_MARKER" ]; then
      BANNED_IPS="$(fail2ban-client -s "$F2B_SOCKET" status asterisk-pjsip 2>/dev/null | sed -n 's/^.*Banned IP list:[[:space:]]*//p' || true)"
      if [ -n "$BANNED_IPS" ]; then
        echo "[SECURITY] Recuperação 0.2.36: a remover bans PJSIP herdados: $BANNED_IPS"
        for ip in $BANNED_IPS; do
          fail2ban-client -s "$F2B_SOCKET" set asterisk-pjsip unbanip "$ip" >/dev/null 2>&1 || true
        done
      else
        echo "[SECURITY] Recuperação 0.2.36: sem bans PJSIP ativos para remover"
      fi
      touch "$F2B_RECOVERY_MARKER"
    fi
  else
    echo "[SECURITY] AVISO: Fail2ban não arrancou; PBX continua disponível."
    echo "[SECURITY] Ver /data/fail2ban/config-test.log e /data/fail2ban/server.log"
    if [ -n "$F2B_PID" ] && kill -0 "$F2B_PID" 2>/dev/null; then
      kill "$F2B_PID" 2>/dev/null || true
    fi
    F2B_PID=""
  fi
else
  echo "[SECURITY] Fail2ban desativado nas opções do add-on"
fi

# Keep the UI available even if Asterisk fails; diagnostics can then be used.
python3 "$APP/server_entry.py" &
UI_PID=$!

VERBOSE="$(python3 - <<'PY'
import json
try:
    print(int(json.load(open('/data/options.json')).get('verbose',3)))
except Exception:
    print(3)
PY
)"

VFLAGS="$(python3 -c 'import sys; n=max(0,min(9,int(sys.argv[1]))); print("-"+"v"*n if n else "")' "$VERBOSE")"
asterisk -f -C "$CONF/asterisk.conf" -U root -G root $VFLAGS &
AST_PID=$!

# Keep Fail2ban in sync with the changing public IP of successfully authenticated
# remote extensions. This only changes the runtime asterisk-pjsip ignore list;
# it does not rewrite endpoint, trunk, SIPcord or GSM configuration.
if [ "$F2B_STARTED" = "1" ]; then
  : > /data/fail2ban/dynamic-whitelist.log
  python3 "$APP/fail2ban_dynamic_whitelist.py" >>/data/fail2ban/dynamic-whitelist.log 2>&1 &
  F2B_WATCH_PID=$!
fi

# Persistent Asterisk wake-up service. Asterisk rings the selected PJSIP
# extension; this lightweight process only handles scheduling and originate.
python3 "$APP/wakeup_scheduler.py" &
WAKE_PID=$!

# chan_dongle USB/module watchdog. It waits for Asterisk through normal CLI
# retries, restores saved GSM profiles when their serial ports reappear, and
# reloads chan_dongle only when the effective binding changes.
python3 "$APP/dongle_watchdog.py" &
DONGLE_PID=$!

cleanup() {
  kill "$AST_PID" "$UI_PID" "$WAKE_PID" "$DONGLE_PID" 2>/dev/null || true
  if [ -n "$F2B_WATCH_PID" ]; then kill "$F2B_WATCH_PID" 2>/dev/null || true; fi
  if [ "$F2B_STARTED" = "1" ]; then
    fail2ban-client -s "$F2B_SOCKET" stop >/dev/null 2>&1 || true
  fi
  if [ -n "$F2B_PID" ]; then kill "$F2B_PID" 2>/dev/null || true; fi
}
trap cleanup INT TERM EXIT
wait "$AST_PID"
